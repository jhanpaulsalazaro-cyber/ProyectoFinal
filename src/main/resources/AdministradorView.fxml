<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane stylesheets="@main.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.proyectofinalfx.viewController.AdministradorViewController">
 <top><HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar"><padding><Insets top="14" right="18" bottom="14" left="18"/></padding><Label text="Panel de administración" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Volver" onAction="#volverPrincipal"/></HBox></top>
 <center><TabPane tabClosingPolicy="UNAVAILABLE">
  <tabs>
   <Tab text="Películas"><VBox spacing="10"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8"><TextField fx:id="txtCodigoPelicula" promptText="Código"/><TextField fx:id="txtNombrePelicula" promptText="Nombre"/><TextField fx:id="txtDuracionPelicula" promptText="Duración (min)"/><ComboBox fx:id="cmbGenero" promptText="Género"/><ComboBox fx:id="cmbClasificacion" promptText="Clasificación"/></HBox>
    <HBox spacing="8"><Button text="Registrar" onAction="#agregarPelicula"/><Button text="Cargar seleccionada" onAction="#seleccionarPelicula"/><Button text="Modificar" onAction="#modificarPelicula"/><Button text="Deshabilitar" onAction="#deshabilitarPelicula"/><Button text="Limpiar" onAction="#limpiarPelicula"/></HBox>
    <TableView fx:id="tablaPeliculas" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colCodigoPelicula" text="Código" prefWidth="80"/><TableColumn fx:id="colNombrePelicula" text="Película" prefWidth="220"/><TableColumn fx:id="colDuracionPelicula" text="Duración" prefWidth="90"/><TableColumn fx:id="colGeneroPelicula" text="Género" prefWidth="120"/><TableColumn fx:id="colEstadoPelicula" text="Estado" prefWidth="130"/></columns></TableView>
   </VBox></Tab>
   <Tab text="Salas"><VBox spacing="10"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8"><TextField fx:id="txtCodigoSala" promptText="Código"/><TextField fx:id="txtNombreSala" promptText="Nombre"/><TextField fx:id="txtCapacidadSala" promptText="Capacidad"/><Button text="Registrar sala" onAction="#agregarSala"/><Button text="Cargar seleccionada" onAction="#seleccionarSala"/><Button text="Modificar" onAction="#modificarSala"/><Button text="Deshabilitar seleccionada" onAction="#deshabilitarSala"/></HBox>
    <TableView fx:id="tablaSalas" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colCodigoSala" text="Código"/><TableColumn fx:id="colNombreSala" text="Sala"/><TableColumn fx:id="colCapacidadSala" text="Capacidad"/><TableColumn fx:id="colEstadoSala" text="Estado"/></columns></TableView>
   </VBox></Tab>
   <Tab text="Funciones"><VBox spacing="10"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Fecha: AAAA-MM-DD | Hora: HH:MM (24 horas)"/><HBox spacing="8"><TextField fx:id="txtCodigoFuncion" promptText="Código"/><TextField fx:id="txtCodigoPeliculaFuncion" promptText="Código película"/><TextField fx:id="txtCodigoSalaFuncion" promptText="Código sala"/><TextField fx:id="txtFechaFuncion" promptText="2026-12-01"/><TextField fx:id="txtHoraFuncion" promptText="18:30"/><TextField fx:id="txtValorFuncion" promptText="Valor base"/><Button text="Programar" onAction="#agregarFuncion"/></HBox>
    <TableView fx:id="tablaFunciones" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colCodigoFuncion" text="Código"/><TableColumn fx:id="colPeliculaFuncion" text="Película"/><TableColumn fx:id="colSalaFuncion" text="Sala"/><TableColumn fx:id="colFechaFuncion" text="Fecha y hora"/></columns></TableView>
   </VBox></Tab>
   <Tab text="Tarifas"><VBox spacing="10"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8"><ComboBox fx:id="cmbTipoTarifa" promptText="Tipo de cliente"/><TextField fx:id="txtValorTarifa" promptText="Precio de entrada"/><Button text="Guardar tarifa" onAction="#agregarTarifa"/></HBox>
    <TableView fx:id="tablaTarifas" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colTipoTarifa" text="Tipo"/><TableColumn fx:id="colValorTarifa" text="Valor"/></columns></TableView>
   </VBox></Tab>
   <Tab text="Reportes"><VBox spacing="10"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Button text="Generar reportes" onAction="#generarReportes"/><TextArea fx:id="txtReportes" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
   </VBox></Tab>
   <Tab text="Clientes"><VBox spacing="10"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8"><TextField fx:id="txtDocumentoCliente" promptText="Documento"/><TextField fx:id="txtNombreCliente" promptText="Nombre"/><ComboBox fx:id="cmbTipoCliente" promptText="Tipo"/><Button text="Registrar cliente" onAction="#agregarCliente"/></HBox>
    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colDocumentoCliente" text="Documento"/><TableColumn fx:id="colNombreCliente" text="Nombre"/><TableColumn fx:id="colTipoCliente" text="Tipo"/></columns></TableView>
   </VBox></Tab>
  </tabs>
 </TabPane></center>
</BorderPane>
