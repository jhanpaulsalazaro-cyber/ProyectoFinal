<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniquindio.edu.co.proyectofinalfx.viewController.ClientesViewController"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="1000"
      prefHeight="650"
      stylesheets="@main.css">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <children>

        <Label text="GESTIÓN DE CLIENTES"
               styleClass="main-title"/>

        <Label text="Registro y consulta de clientes"
               styleClass="subtitle"/>

        <HBox spacing="12" alignment="CENTER">
            <TextField fx:id="txtDocumento"
                       promptText="Documento de identidad"
                       prefWidth="230"/>

            <TextField fx:id="txtNombre"
                       promptText="Nombre del cliente"
                       prefWidth="230"/>

            <ComboBox fx:id="cmbTipoCliente"
                      promptText="Seleccione el tipo de cliente"
                      prefWidth="230"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="btnRegistrar"
                    text="REGISTRAR"
                    styleClass="button"
                    onAction="#registrarCliente"/>

            <Button fx:id="btnBuscar"
                    text="BUSCAR"
                    styleClass="button"
                    onAction="#buscarCliente"/>

            <Button fx:id="btnLimpiar"
                    text="LIMPIAR"
                    styleClass="button"
                    onAction="#limpiarCampos"/>
        </HBox>

        <Label text="CLIENTES REGISTRADOS"
               styleClass="section-title"/>

        <TableView fx:id="tablaClientes"
                   prefHeight="350"
                   prefWidth="850">

            <columns>
                <TableColumn fx:id="colDocumento"
                             text="Documento"
                             prefWidth="300"/>

                <TableColumn fx:id="colNombre"
                             text="Nombre"
                             prefWidth="500"/>
            </columns>

        </TableView>

        <Button fx:id="btnVolver"
                text="VOLVER AL INICIO"
                styleClass="button"
                onAction="#volverPortada"/>

    </children>
</VBox>
