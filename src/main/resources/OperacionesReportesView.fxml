<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniquindio.edu.co.proyectofinalfx.viewController.OperacionesReportesViewController"
      alignment="TOP_CENTER"
      spacing="15"
      prefWidth="1000"
      prefHeight="650"
      stylesheets="@main.css">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <children>

        <Label text="OPERACIONES Y REPORTES"
               styleClass="main-title"/>

        <Label text="Consulta y cancelación de ventas"
               styleClass="subtitle"/>

        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="txtDocumentoOperador"
                       promptText="Documento del operador"
                       prefWidth="220"/>

            <TextField fx:id="txtCodigoVenta"
                       promptText="Código de venta"
                       prefWidth="200"/>

            <Button fx:id="btnBuscarVenta"
                    text="BUSCAR VENTA"
                    onAction="#buscarVenta"
                    styleClass="button"/>

            <Button fx:id="btnCancelarVenta"
                    text="CANCELAR VENTA"
                    onAction="#cancelarVenta"
                    styleClass="button"/>
        </HBox>

        <Label text="VENTAS REGISTRADAS"
               styleClass="section-title"/>

        <TableView fx:id="tablaVentas" prefHeight="250">
            <columns>
                <TableColumn fx:id="colCodigoVenta"
                             text="Código"
                             prefWidth="100"/>

                <TableColumn fx:id="colCliente"
                             text="Cliente"
                             prefWidth="200"/>

                <TableColumn fx:id="colPelicula"
                             text="Película"
                             prefWidth="200"/>

                <TableColumn fx:id="colValor"
                             text="Valor"
                             prefWidth="150"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="150"/>
            </columns>
        </TableView>

        <Label text="REPORTES GENERALES"
               styleClass="section-title"/>

        <Label fx:id="lblTotalEntradas"
               text="Total de entradas vendidas: 0"/>

        <Label fx:id="lblTotalIngresos"
               text="Total de ingresos: $0"/>

        <Label fx:id="lblPeliculaMasVendida"
               text="Película más vendida: Sin datos"/>

        <Button fx:id="btnActualizarReportes"
                text="ACTUALIZAR REPORTES"
                onAction="#actualizarReportes"
                styleClass="button"/>

        <Button fx:id="btnVolver"
                text="VOLVER AL INICIO"
                onAction="#volverPortada"
                styleClass="button"/>

    </children>
</VBox>