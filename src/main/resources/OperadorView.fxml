<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.proyectofinalfx.viewController.OperadorViewController"
            prefWidth="1440" prefHeight="900" styleClass="app-root">
 <left>
  <VBox prefWidth="258" spacing="18" styleClass="sidebar">
   <padding><Insets top="24" right="16" bottom="18" left="16"/></padding>
   <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
    <StackPane prefWidth="42" prefHeight="42" styleClass="brand-icon"><Label text="▶" styleClass="brand-symbol"/></StackPane>
    <VBox spacing="2"><Label text="CINEMAUQ" styleClass="brand-title"/><Label text="Operador" styleClass="brand-subtitle"/></VBox>
   </HBox>
   <Button text="＋   Nuevo Cliente" onAction="#abrirRegistroCliente" maxWidth="Infinity" styleClass="primary-button"/>
   <VBox spacing="7">
    <Label text="CONSULTAS" styleClass="nav-section"/>
    <Button fx:id="btnCartelera" text="▣   Cartelera y Funciones" onAction="#mostrarCartelera" maxWidth="Infinity" styleClass="nav-button nav-active"/>
    <Button fx:id="btnDisponibilidad" text="◫   Disponibilidad" onAction="#mostrarDisponibilidad" maxWidth="Infinity" styleClass="nav-button"/>
    <Label text="TAQUILLA" styleClass="nav-section nav-gap"/>
    <Button fx:id="btnVenta" text="▤   Vender entrada" onAction="#mostrarVenta" maxWidth="Infinity" styleClass="nav-button"/>
    <Button fx:id="btnCancelacion" text="✕   Cancelar venta" onAction="#mostrarCancelacion" maxWidth="Infinity" styleClass="nav-button"/>
   </VBox>
   <Region VBox.vgrow="ALWAYS"/>
   <VBox spacing="9" styleClass="sidebar-footer">
    <Label text="●  Turno activo · Operador" styleClass="status-label"/>
    <Button fx:id="btnCambiarRol" text="⇦   Cambiar de rol" onAction="#cambiarRol" maxWidth="Infinity" styleClass="secondary-button"/>
    <Label text="Universidad del Quindío" styleClass="footer-caption"/>
   </VBox>
  </VBox>
 </left>
 <center>
  <BorderPane styleClass="main-area">
   <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
    <padding><Insets top="16" right="30" bottom="16" left="30"/></padding>
    <Label fx:id="lblTituloVista" text="Cartelera y Funciones" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/>
    <VBox alignment="CENTER_RIGHT" spacing="2"><Label text="Clientes registrados" styleClass="muted-label"/><Label fx:id="lblTotalClientes" text="0" styleClass="counter-label"/></VBox>
   </HBox></top>
   <center>
    <StackPane styleClass="content-background">

     <!-- CONSULTAR PELÍCULAS Y FUNCIONES -->
     <ScrollPane fx:id="scrollCartelera" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
      <content><VBox spacing="22" styleClass="page-content">
       <VBox spacing="4"><Label text="Películas disponibles" styleClass="section-title"/><Label text="Nombre, género, duración y clasificación por edad" styleClass="muted-label"/></VBox>
       <FlowPane fx:id="contenedorPeliculas" hgap="14" vgap="14"/>
       <VBox spacing="12" styleClass="panel"><Label text="Funciones programadas" styleClass="section-title"/>
        <TableView fx:id="tablaFunciones" prefHeight="300"><columns>
         <TableColumn fx:id="colFuncionPelicula" text="Película" prefWidth="240"/><TableColumn fx:id="colFuncionSala" text="Sala" prefWidth="150"/>
         <TableColumn fx:id="colFuncionFecha" text="Fecha" prefWidth="130"/><TableColumn fx:id="colFuncionHora" text="Hora" prefWidth="100"/>
         <TableColumn fx:id="colFuncionPrecio" text="Valor entrada" prefWidth="140"/><TableColumn fx:id="colFuncionDisponibles" text="Asientos disponibles" prefWidth="170"/>
        </columns></TableView>
       </VBox>
      </VBox></content>
     </ScrollPane>

     <!-- CONSULTAR DISPONIBILIDAD DE FUNCIONES -->
     <ScrollPane fx:id="scrollDisponibilidad" fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false" styleClass="content-scroll">
      <content><VBox spacing="18" styleClass="page-content">
       <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Función" styleClass="field-label"/><ComboBox fx:id="cmbFuncionDisponibilidad" prefWidth="520" promptText="Selecciona una función" onAction="#consultarDisponibilidad"/></HBox>
       <GridPane hgap="14"><columnConstraints><ColumnConstraints percentWidth="33.3"/><ColumnConstraints percentWidth="33.3"/><ColumnConstraints percentWidth="33.4"/></columnConstraints>
        <VBox styleClass="kpi-card" spacing="8"><Label text="Total de asientos" styleClass="muted-label"/><Label fx:id="lblDispTotal" text="0" styleClass="kpi-value"/></VBox>
        <VBox styleClass="kpi-card" spacing="8" GridPane.columnIndex="1"><Label text="Disponibles" styleClass="muted-label"/><Label fx:id="lblDispLibres" text="0" styleClass="kpi-value kpi-free"/></VBox>
        <VBox styleClass="kpi-card" spacing="8" GridPane.columnIndex="2"><Label text="Ocupados" styleClass="muted-label"/><Label fx:id="lblDispOcupados" text="0" styleClass="kpi-value kpi-busy"/></VBox>
       </GridPane>
       <VBox spacing="14" styleClass="panel" alignment="TOP_CENTER">
        <Label text="Mapa de la sala" styleClass="section-title"/>
        <StackPane prefHeight="28" maxWidth="420" styleClass="cinema-screen"><Label text="PANTALLA" styleClass="screen-label"/></StackPane>
        <TilePane fx:id="mapaDisponibilidad" prefColumns="8" hgap="9" vgap="9" alignment="CENTER"/>
        <HBox alignment="CENTER" spacing="18"><Label text="● Disponible" styleClass="legend-free"/><Label text="● Ocupado" styleClass="legend-busy"/></HBox>
        <Label fx:id="lblAsientosLibres" text="" styleClass="muted-label" wrapText="true"/>
       </VBox>
      </VBox></content>
     </ScrollPane>

     <!-- REGISTRAR VENTA -->
     <ScrollPane fx:id="scrollVenta" fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false" styleClass="content-scroll">
      <content><VBox spacing="18" styleClass="page-content"><GridPane hgap="18" vgap="18">
       <columnConstraints><ColumnConstraints percentWidth="43"/><ColumnConstraints percentWidth="57"/></columnConstraints>
       <VBox spacing="14" styleClass="panel" GridPane.columnIndex="0">
        <Label text="Datos de la venta" styleClass="section-title"/>
        <Label text="Película" styleClass="field-label"/><ComboBox fx:id="cmbPeliculasVenta" maxWidth="Infinity" promptText="Selecciona película" onAction="#seleccionarPeliculaVenta"/>
        <Label text="Función" styleClass="field-label"/><ComboBox fx:id="cmbFuncionesVenta" maxWidth="Infinity" promptText="Selecciona función" onAction="#seleccionarFuncionVenta"/>
        <HBox alignment="CENTER_LEFT"><Label text="Cliente" styleClass="field-label"/><Region HBox.hgrow="ALWAYS"/><Hyperlink text="+ Registrar nuevo" onAction="#abrirRegistroCliente"/></HBox>
        <ComboBox fx:id="cmbClientesVenta" maxWidth="Infinity" promptText="Documento · Nombre" onAction="#seleccionarClienteVenta"/>
        <Label text="Tipo de entrada" styleClass="field-label"/><ComboBox fx:id="cmbTarifasVenta" maxWidth="Infinity" promptText="Selecciona tarifa" onAction="#calcularTotalVenta"/>
        <Separator/><HBox><Label text="Asiento seleccionado" styleClass="muted-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblAsientoSeleccionado" text="Ninguno" styleClass="accent-value"/></HBox>
        <HBox><Label text="Total a cobrar" styleClass="field-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTotalVenta" text="\$ 0" styleClass="total-value"/></HBox>
        <Button text="Confirmar venta" onAction="#registrarVenta" maxWidth="Infinity" styleClass="success-button"/>
       </VBox>
       <VBox spacing="14" styleClass="panel" GridPane.columnIndex="1">
        <Label text="Mapa de sala" styleClass="section-title"/><Label fx:id="lblResumenAsientos" text="Selecciona una función para ver los asientos" styleClass="muted-label"/>
        <StackPane prefHeight="28" maxWidth="420" styleClass="cinema-screen"><Label text="PANTALLA" styleClass="screen-label"/></StackPane>
        <TilePane fx:id="contenedorAsientos" prefColumns="8" hgap="9" vgap="9" alignment="CENTER"/>
        <HBox alignment="CENTER" spacing="18"><Label text="● Disponible" styleClass="legend-free"/><Label text="● Seleccionado" styleClass="legend-selected"/><Label text="● Ocupado" styleClass="legend-busy"/></HBox>
       </VBox>
      </GridPane></VBox></content>
     </ScrollPane>

     <!-- CANCELAR VENTA -->
     <ScrollPane fx:id="scrollCancelacion" fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false" styleClass="content-scroll">
      <content><VBox spacing="18" styleClass="page-content"><VBox spacing="14" styleClass="panel">
       <Label text="Historial y cancelación de ventas" styleClass="section-title"/>
       <HBox spacing="10"><TextField fx:id="txtBuscarVenta" promptText="Código de venta" HBox.hgrow="ALWAYS"/><Button text="Buscar" onAction="#buscarVenta" styleClass="secondary-button"/><Button text="Mostrar todas" onAction="#mostrarVentas" styleClass="secondary-button"/></HBox>
       <TableView fx:id="tablaVentas" prefHeight="460"><columns>
        <TableColumn fx:id="colVentaCodigo" text="Código" prefWidth="80"/><TableColumn fx:id="colVentaFecha" text="Fecha venta" prefWidth="140"/><TableColumn fx:id="colVentaCliente" text="Cliente" prefWidth="170"/>
        <TableColumn fx:id="colVentaFuncion" text="Función" prefWidth="190"/><TableColumn fx:id="colVentaAsiento" text="Asiento" prefWidth="90"/>
        <TableColumn fx:id="colVentaValor" text="Total" prefWidth="120"/><TableColumn fx:id="colVentaEstado" text="Estado" prefWidth="110"/>
       </columns></TableView>
       <HBox alignment="CENTER_RIGHT"><Button text="Anular venta seleccionada" onAction="#cancelarVenta" styleClass="danger-button"/></HBox>
      </VBox></VBox></content>
     </ScrollPane>

    </StackPane>
   </center>
  </BorderPane>
 </center>
</BorderPane>
