<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane stylesheets="@main.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.proyectofinalfx.viewController.OperadorViewController">
 <top><HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar"><padding><Insets top="14" right="18" bottom="14" left="18"/></padding><Label text="Panel del operador" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Actualizar" onAction="#consultarFunciones"/><Button text="Volver" onAction="#volverPrincipal"/></HBox></top>
 <center><VBox spacing="12"><padding><Insets top="12" right="14" bottom="14" left="14"/></padding>
  <Label text="Películas disponibles" styleClass="section-title"/>
  <TableView fx:id="tablaPeliculas" prefHeight="90"><columns><TableColumn fx:id="colNombrePelicula" text="Película" prefWidth="220"/><TableColumn fx:id="colGeneroPelicula" text="Género"/><TableColumn fx:id="colDuracionPelicula" text="Duración"/><TableColumn fx:id="colClasificacionPelicula" text="Clasificación"/></columns></TableView>
  <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Funciones programadas" styleClass="section-title"/><TextField fx:id="txtFechaConsulta" promptText="Filtrar fecha AAAA-MM-DD"/><Button text="Consultar" onAction="#consultarFunciones"/></HBox>
  <TableView fx:id="tablaCartelera" prefHeight="130"><columns><TableColumn fx:id="colCodigoFuncion" text="Código"/><TableColumn fx:id="colPelicula" text="Película" prefWidth="220"/><TableColumn fx:id="colHorario" text="Fecha y hora" prefWidth="180"/><TableColumn fx:id="colSala" text="Sala"/></columns></TableView>
  <Label text="Asientos de la función seleccionada" styleClass="section-title"/>
  <TableView fx:id="tablaAsientos" prefHeight="170"><columns><TableColumn fx:id="colAsiento" text="Asiento"/><TableColumn fx:id="colEstadoAsiento" text="Estado general"/></columns></TableView>
  <Label fx:id="labelResumen" text="Disponibilidad"/>
  <HBox spacing="8"><TextField fx:id="txtCodigoVenta" promptText="Código de venta"/><TextField fx:id="txtDocumentoCliente" promptText="Documento del cliente"/><ComboBox fx:id="cmbTipoCliente" promptText="Tarifa"/><Button text="Registrar venta" onAction="#registrarVenta"/></HBox>
  <Label text="Ventas registradas" styleClass="section-title"/>
  <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colCodigoVenta" text="Código"/><TableColumn fx:id="colDetalleVenta" text="Detalle" prefWidth="420"/></columns></TableView>
  <Button text="Cancelar venta seleccionada" onAction="#cancelarVenta"/>
 </VBox></center>
</BorderPane>
