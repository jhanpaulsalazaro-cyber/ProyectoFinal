<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniquindio.edu.co.proyectofinalfx.viewController.PortadaViewController"
      alignment="CENTER"
      spacing="25.0"
      prefWidth="900.0"
      prefHeight="600.0"
      stylesheets="@main.css">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <children>

        <Label text="CINEMAUQ"
               styleClass="main-title"/>

        <Label text="Sistema de gestión de cine"
               styleClass="subtitle"/>

        <Button fx:id="btnClientes"
                text="CLIENTES"
                onAction="#abrirClientes"
                prefWidth="280"
                prefHeight="55"
                styleClass="button"/>

        <Button fx:id="btnPeliculas"
                text="PELÍCULAS"
                onAction="#abrirPeliculas"
                prefWidth="280"
                prefHeight="55"
                styleClass="button"/>

        <Button fx:id="btnOperaciones"
                text="OPERACIONES Y REPORTES"
                onAction="#abrirOperaciones"
                prefWidth="280"
                prefHeight="55"
                styleClass="button"/>

    </children>

</VBox>
